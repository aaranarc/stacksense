{"language": "hi", "humanReviewed": false, "message": {"id": "m093", "at": "2026-10-30T10:44:00.000Z", "senderKey": "S01", "text": "Daag roz bada ho raha hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m094", "at": "2026-10-30T10:51:00.000Z", "senderKey": "S04", "text": "Photo andhera aa gaya, dobara bhejta hoon", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
