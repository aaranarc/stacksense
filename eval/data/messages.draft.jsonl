{"language": "hi", "humanReviewed": false, "message": {"id": "m099", "at": "2026-10-30T11:26:00.000Z", "senderKey": "S05", "text": "Plumber bola nahani trap ke aas paas grout toot gaya hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m100", "at": "2026-10-30T11:33:00.000Z", "senderKey": "S01", "text": "402 ke bathroom ki ceiling pe daag hai, duct ke paas", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
