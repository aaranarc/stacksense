{"language": "en", "humanReviewed": false, "message": {"id": "m075", "at": "2026-10-30T08:38:00.000Z", "senderKey": "S13", "text": "We will find out with the next check, not blaming anyone", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m076", "at": "2026-10-30T08:45:00.000Z", "senderKey": "S01", "text": "402 ke bathroom ki ceiling pe daag hai, duct ke paas", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m077", "at": "2026-10-30T08:52:00.000Z", "senderKey": "S05", "text": "Hamara floor bilkul dry hai bhai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m078", "at": "2026-10-30T08:59:00.000Z", "senderKey": "S03", "text": "Kal raat baarish ke baad 202 ki deewar pe khidki ke paas daag", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m079", "at": "2026-10-30T09:06:00.000Z", "senderKey": "S06", "text": "Bathroom ki light se paani tapak raha hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m080", "at": "2026-10-30T09:13:00.000Z", "senderKey": "S13", "text": "Main switch band karo abhi", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m081", "at": "2026-10-30T09:20:00.000Z", "senderKey": "S07", "text": "Switch board ke paas paani aa raha hai, halka karant laga", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m082", "at": "2026-10-30T09:27:00.000Z", "senderKey": "S04", "text": "302 ka duct wall sukha hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m083", "at": "2026-10-30T09:34:00.000Z", "senderKey": "S05", "text": "Meter 10 minute mein bilkul nahi hila, saare nal band the", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m084", "at": "2026-10-30T09:41:00.000Z", "senderKey": "S10", "text": "Hamara meter nal band hone ke baad bhi chal raha hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m085", "at": "2026-10-30T09:48:00.000Z", "senderKey": "S08", "text": "Kitchen ki chhat pe gas ke upar kaale daag", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m086", "at": "2026-10-30T09:55:00.000Z", "senderKey": "S11", "text": "Top floor hai, baarish mein bedroom ki chhat tapakti hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m087", "at": "2026-10-30T10:02:00.000Z", "senderKey": "S12", "text": "Upar flush karte hi WC ki chhat geeli ho jaati hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m088", "at": "2026-10-30T10:09:00.000Z", "senderKey": "S02", "text": "Koi update?", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m089", "at": "2026-10-30T10:16:00.000Z", "senderKey": "S06", "text": "Chhat jhuk rahi hai, beech mein phool gayi hai", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
{"language": "hi", "humanReviewed": false, "message": {"id": "m090", "at": "2026-10-30T10:23:00.000Z", "senderKey": "S13", "text": "Us kamre mein mat jao, plumber ko bula rahe hain", "attachmentIds": []}, "labels": {"flatId": null, "room": null, "zone": null, "surface": null, "hazards": null, "kind": null}}
